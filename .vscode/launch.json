{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug test_qvadis (cppvsdbg)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test_qvadis.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/build;${env:PATH}"
                }
            ],
            "console": "integratedTerminal", 
        },
        {
            "name": "Debug test_qvadis (cppdbg/lldb/gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test_qvadis.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${workspaceFolder}/build;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Tools/LLVM/bin/lldb.exe",
            "preLaunchTask": "CMake: Build (Debug)"
        }
    ]
}
